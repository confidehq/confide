---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Pricing | Confide">
	<div class="container">
		<nav class="nav">
			<div class="logo-group">
				<a href="/" class="logo">
					<img src="/favicon.svg" alt="Confide" class="logo-icon" />
					<span>Confide</span>
				</a>
				<span class="tagline">The <strong>secure</strong> way to listen.</span>
			</div>
			<div class="nav-actions">
				<ul class="nav-links">
					<li><a href="/pricing">Pricing</a></li>
					<li><a href="https://admin.useconfide.app/login">Log in</a></li>
				</ul>
				<a href="https://admin.useconfide.app/signup" class="btn btn-primary">Start Protecting Data</a>
			</div>
		</nav>

		<main>
			<section class="pricing-hero">
				<span class="muted-label">PRICING</span>
				<h1>Simple, transparent pricing for <em>secure</em> data collection.</h1>
				<p>Choose the plan that fits your organization's needs. All plans include our core end-to-end encryption technology.</p>
			</section>

			<section class="pricing-grid">
				<div class="pricing-card">
					<div class="plan-header">
						<span class="plan-name">Free</span>
						<div class="plan-price">
							<span class="currency">$</span>
							<span class="amount">0</span>
							<span class="period">/mo</span>
						</div>
						<p class="plan-desc">Everything you need to create forms and securely collect responses.</p>
					</div>
					<ul class="plan-features">
						<li>
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
							1 Workspace (Owner only)
						</li>
						<li>
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
							3 Forms
						</li>
						<li>
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
							100 Submissions /mo
						</li>
						<li>
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
							50 Email notifications /mo
						</li>
						<li>
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
							Powered by Confide watermark
						</li>
					</ul>
					<a href="https://admin.useconfide.app/signup" class="btn btn-secondary plan-btn">Get Started</a>
				</div>

				<div class="pricing-card featured">
					<div class="plan-header">
						<div class="badge">Most Popular</div>
						<span class="plan-name">Pro</span>
						<div class="plan-price">
							<span class="currency">$</span>
							<span class="amount">19</span>
							<span class="period">/mo</span>
						</div>
						<p class="plan-desc">Ideal for small teams and growing organizations.</p>
					</div>
					<ul class="plan-features">
						<li>
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
							25 Forms per workspace
						</li>
						<li>
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
							2,500 Submissions /mo
						</li>
						<li>
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
							Up to 5 Team members
						</li>
						<li>
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
							500 Email notifications /mo
						</li>
						<li>
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
							1 Custom domain
						</li>
						<li>
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
							Remove Confide branding
						</li>
						<li>
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
							Priority email support
						</li>
					</ul>
					<a href="https://admin.useconfide.app/signup" class="btn btn-primary plan-btn">Start 14-day Trial</a>
				</div>

				<div class="pricing-card">
					<div class="plan-header">
						<span class="plan-name">Organization</span>
						<div class="plan-price">
							<span class="currency">$</span>
							<span class="amount">49</span>
							<span class="period">/mo</span>
						</div>
						<p class="plan-desc">For large organizations requiring maximum scale.</p>
					</div>
					<ul class="plan-features">
						<li>
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
							Unlimited Forms
						</li>
						<li>
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
							10,000 Submissions /mo
						</li>
						<li>
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
							Unlimited Team members
						</li>
						<li>
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
							2,000 Email notifications /mo
						</li>
						<li>
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
							3 Custom domains
						</li>
						<li>
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
							Priority support
						</li>
						<li>
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
							Everything in Pro
						</li>
					</ul>
					<a href="https://admin.useconfide.app/signup" class="btn btn-secondary plan-btn">Contact Sales</a>
				</div>
			</section>

			<section class="comparison-section">
				<div class="comparison-header">
					<h2>Compare Features</h2>
					<p>Deep dive into everything Confide has to offer.</p>
				</div>

				<div class="table-container">
					<table class="comparison-table">
						<thead>
							<tr>
								<th>Feature</th>
								<th>Free</th>
								<th>Pro</th>
								<th>Organization</th>
							</tr>
						</thead>
						<tbody>
							<tr class="table-category">
								<td colspan="4">Security & Privacy</td>
							</tr>
							<tr>
								<td>End-to-end encrypted forms</td>
								<td><span class="check">✓</span></td>
								<td><span class="check">✓</span></td>
								<td><span class="check">✓</span></td>
							</tr>
							<tr>
								<td>End-to-end encrypted responses</td>
								<td><span class="check">✓</span></td>
								<td><span class="check">✓</span></td>
								<td><span class="check">✓</span></td>
							</tr>
							<tr>
								<td>Email forwarding (PGP Encryption)</td>
								<td><span class="check">✓</span></td>
								<td><span class="check">✓</span></td>
								<td><span class="check">✓</span></td>
							</tr>
							<tr>
								<td>Multiple passkeys per account</td>
								<td><span class="check">✓</span></td>
								<td><span class="check">✓</span></td>
								<td><span class="check">✓</span></td>
							</tr>
							<tr>
								<td>Spam protection & honeypots</td>
								<td><span class="check">✓</span></td>
								<td><span class="check">✓</span></td>
								<td><span class="check">✓</span></td>
							</tr>
							<tr class="table-category">
								<td colspan="4">Form Management</td>
							</tr>
							<tr>
								<td>Multi-language support</td>
								<td><span class="check">✓</span></td>
								<td><span class="check">✓</span></td>
								<td><span class="check">✓</span></td>
							</tr>
							<tr>
								<td>Automatically close forms</td>
								<td><span class="check">✓</span></td>
								<td><span class="check">✓</span></td>
								<td><span class="check">✓</span></td>
							</tr>
							<tr>
								<td>Auto-delete responses</td>
								<td><span class="check">✓</span></td>
								<td><span class="check">✓</span></td>
								<td><span class="check">✓</span></td>
							</tr>
							<tr>
								<td>Response analytics</td>
								<td>Basic</td>
								<td>Advanced</td>
								<td>Advanced</td>
							</tr>
							<tr>
								<td>Version history</td>
								<td>—</td>
								<td><span class="check">✓</span></td>
								<td><span class="check">✓</span></td>
							</tr>
							<tr class="table-category">
								<td colspan="4">Team & Infrastructure</td>
							</tr>
							<tr>
								<td>Teams & Workspaces</td>
								<td>1 (Owner only)</td>
								<td>Unlimited</td>
								<td>Unlimited</td>
							</tr>
							<tr>
								<td>Team members</td>
								<td>1</td>
								<td>Up to 5</td>
								<td>Unlimited</td>
							</tr>
							<tr>
								<td>Role-based access control (RBAC)</td>
								<td>—</td>
								<td><span class="check">✓</span></td>
								<td><span class="check">✓</span></td>
							</tr>
							<tr>
								<td>Custom domains</td>
								<td>—</td>
								<td>1</td>
								<td>3</td>
							</tr>
							<tr>
								<td>Custom email sender</td>
								<td>—</td>
								<td><span class="check">✓</span></td>
								<td><span class="check">✓</span></td>
							</tr>
							<tr>
								<td>Remove branding</td>
								<td>—</td>
								<td><span class="check">✓</span></td>
								<td><span class="check">✓</span></td>
							</tr>
						</tbody>
					</table>
				</div>
			</section>

			<section class="faq-section">
				<div class="faq-header">
					<h2>Pricing FAQ</h2>
				</div>
				<div class="faq-list">
					<details class="faq-item">
						<summary class="faq-question">
							<span>Can I change plans later?</span>
							<span class="faq-icon" aria-hidden="true"></span>
						</summary>
						<div class="faq-answer">
							<p>Yes, you can upgrade or downgrade your plan at any time from your workspace settings. Changes are reflected immediately.</p>
						</div>
					</details>
					<details class="faq-item">
						<summary class="faq-question">
							<span>Is there a discount for non-profits?</span>
							<span class="faq-icon" aria-hidden="true"></span>
						</summary>
						<div class="faq-answer">
							<p>We offer additional discounts and tailored plans for registered 501(c)(3) organizations and equivalent NGOs worldwide. Contact our support team to learn more.</p>
						</div>
					</details>
					<details class="faq-item">
						<summary class="faq-question">
							<span>What happens if I exceed my submission limit?</span>
							<span class="faq-icon" aria-hidden="true"></span>
						</summary>
						<div class="faq-answer">
							<p>We'll notify you when you reach 80% and 100% of your limit. Once reached, your forms will temporarily stop accepting new responses until the next month or you upgrade your plan.</p>
						</div>
					</details>
				</div>
			</section>
		</main>

		<footer class="footer">
			<div class="footer-content">
				<div class="footer-brand">
					<img src="/favicon.svg" alt="Confide" class="logo-icon" />
					<span class="footer-logo-text">Confide</span>
				</div>
				<ul class="footer-links">
					<li><a href="https://admin.useconfide.app/login">Sign in</a></li>
					<li><a href="/trust">Trust & Safety</a></li>
					<li><a href="/security">Security Architecture</a></li>
					<li><a href="/privacy">Privacy Policy</a></li>
					<li><a href="/terms">Terms of Service</a></li>
					<li><a href="https://github.com/confidehq/confide" target="_blank" rel="noopener">Open Source</a></li>
				</ul>
			</div>
		</footer>
	</div>
</Layout>

<style>
	.container {
		max-width: var(--container-width);
		margin: 0 auto;
		padding: 0 2rem;
		min-height: 100vh;
		display: flex;
		flex-direction: column;
	}

	.nav {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 2rem 0;
	}

	.logo-group {
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.tagline {
		font-size: 0.9375rem;
		color: var(--muted-color);
		font-weight: 500;
	}

	.logo {
		font-size: 1.5rem;
		font-weight: 700;
		letter-spacing: -0.03em;
		display: flex;
		align-items: center;
		gap: 0.625rem;
	}

	.logo-icon {
		width: 28px;
		height: 28px;
	}

	.nav-actions {
		display: flex;
		align-items: center;
		gap: 1.5rem;
	}

	.nav-links {
		display: flex;
		gap: 1.5rem;
	}

	.nav-links a {
		font-size: 0.9375rem;
		color: var(--muted-color);
		font-weight: 600;
		transition: var(--transition-base);
	}

	.nav-links a:hover {
		color: var(--fg-color);
	}

	.pricing-hero {
		text-align: center;
		padding: 6rem 0 4rem;
	}

	.muted-label {
		display: block;
		font-size: 0.75rem;
		color: var(--muted-color);
		margin-bottom: 1rem;
		letter-spacing: 0.15em;
		font-weight: 700;
	}

	.pricing-hero h1 {
		font-size: clamp(2.5rem, 6vw, 3.5rem);
		font-weight: 800;
		line-height: 1.1;
		margin-bottom: 1.5rem;
		letter-spacing: -0.04em;
		max-width: 800px;
		margin-left: auto;
		margin-right: auto;
	}

	.pricing-hero p {
		font-size: 1.25rem;
		color: var(--muted-color);
		max-width: 600px;
		margin: 0 auto;
		line-height: 1.5;
	}

	.pricing-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 2rem;
		padding: 4rem 0 6rem;
		align-items: start;
	}

	.pricing-card {
		background-color: var(--secondary-bg);
		border: 1px solid var(--border-color);
		border-radius: 1.5rem;
		padding: 3rem 2rem;
		display: flex;
		flex-direction: column;
		gap: 2rem;
		transition: var(--transition-base);
		position: relative;
	}

	.pricing-card:hover {
		border-color: var(--accent-amber);
		transform: translateY(-4px);
	}

	.pricing-card.featured {
		border-color: var(--accent-amber);
		background-color: var(--bg-color);
		box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1);
		z-index: 1;
	}

	.badge {
		position: absolute;
		top: -0.75rem;
		left: 50%;
		transform: translateX(-50%);
		background-color: var(--accent-amber);
		color: white;
		padding: 0.25rem 1rem;
		border-radius: 9999px;
		font-size: 0.75rem;
		font-weight: 800;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}

	.plan-header {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.plan-name {
		font-size: 1.25rem;
		font-weight: 700;
		color: var(--muted-color);
	}

	.plan-price {
		display: flex;
		align-items: baseline;
		gap: 0.25rem;
	}

	.currency {
		font-size: 1.5rem;
		font-weight: 700;
		color: var(--muted-color);
	}

	.amount {
		font-size: 3.5rem;
		font-weight: 800;
		letter-spacing: -0.04em;
	}

	.period {
		font-size: 1.125rem;
		color: var(--muted-color);
		font-weight: 600;
	}

	.plan-desc {
		font-size: 1rem;
		color: var(--muted-color);
		line-height: 1.5;
	}

	.plan-features {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.plan-features li {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		font-size: 1rem;
		color: var(--fg-color);
		font-weight: 500;
	}

	.plan-features li svg {
		color: var(--accent-green);
		flex-shrink: 0;
	}

	.plan-btn {
		width: 100%;
		margin-top: auto;
	}

	/* Comparison Table */
	.comparison-section {
		padding: 6rem 0;
		border-top: 1px solid var(--border-color);
	}

	.comparison-header {
		text-align: center;
		margin-bottom: 4rem;
	}

	.comparison-header h2 {
		font-size: 2.25rem;
		font-weight: 700;
		letter-spacing: -0.03em;
		margin-bottom: 1rem;
	}

	.comparison-header p {
		font-size: 1.125rem;
		color: var(--muted-color);
	}

	.table-container {
		width: 100%;
		overflow-x: auto;
		border-radius: 1rem;
		border: 1px solid var(--border-color);
	}

	.comparison-table {
		width: 100%;
		border-collapse: collapse;
		text-align: left;
		font-size: 0.9375rem;
	}

	.comparison-table th,
	.comparison-table td {
		padding: 1.25rem 1.5rem;
		border-bottom: 1px solid var(--border-color);
	}

	.comparison-table th {
		font-weight: 700;
		color: var(--fg-color);
		background-color: var(--secondary-bg);
		font-size: 1rem;
	}

	.comparison-table th:not(:first-child) {
		text-align: center;
	}

	.comparison-table th:first-child {
		width: 40%;
	}

	.comparison-table tr:last-child td {
		border-bottom: none;
	}

	.table-category td {
		background-color: color-mix(in srgb, var(--secondary-bg), transparent 50%);
		font-weight: 800;
		text-transform: uppercase;
		font-size: 0.75rem;
		letter-spacing: 0.1em;
		color: var(--muted-color);
		padding-top: 2rem;
		padding-bottom: 1rem;
	}

	.check {
		color: var(--accent-green);
		font-weight: 900;
		font-size: 1.125rem;
	}

	.comparison-table td:not(:first-child) {
		text-align: center;
		font-weight: 600;
		color: var(--muted-color);
	}

	.comparison-table td:first-child {
		font-weight: 600;
		color: var(--fg-color);
	}

	/* FAQ Section */
	.faq-section {
		padding: 6rem 0;
		border-top: 1px solid var(--border-color);
	}

	.faq-header {
		margin-bottom: 3.5rem;
		text-align: center;
	}

	.faq-header h2 {
		font-size: 2.25rem;
		font-weight: 700;
		letter-spacing: -0.03em;
	}

	.faq-list {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		max-width: 800px;
		margin: 0 auto;
	}

	.faq-item {
		border-radius: 1rem;
		border: 1px solid var(--border-color);
		background-color: transparent;
		transition: var(--transition-base);
	}

	.faq-item:hover {
		border-color: var(--accent-amber);
	}

	.faq-question {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1.5rem;
		padding: 1.5rem;
		font-size: 1.125rem;
		font-weight: 700;
		cursor: pointer;
		list-style: none;
	}

	.faq-icon {
		flex-shrink: 0;
		width: 1.5rem;
		height: 1.5rem;
		position: relative;
		color: var(--muted-color);
		transition: transform 0.3s ease;
	}

	.faq-icon::before,
	.faq-icon::after {
		content: '';
		position: absolute;
		background-color: currentColor;
		border-radius: 2px;
	}

	.faq-icon::before {
		width: 100%;
