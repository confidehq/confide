<script is:inline>
	function initTableSections() {
		document.querySelectorAll('.table-category').forEach(row => {
			row.style.cursor = 'pointer';
			row.addEventListener('click', () => {
				const isCollapsed = row.classList.toggle('collapsed');
				let sibling = row.nextElementSibling;
				while (sibling && !sibling.classList.contains('table-category')) {
					sibling.classList.toggle('section-hidden', isCollapsed);
					sibling = sibling.nextElementSibling;
				}
			});
		});
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initTableSections);
	} else {
		initTableSections();
	}

	function initPricingToggle() {
		const toggle = document.getElementById('pricing-toggle');
		if (!toggle) return;

		const labels = document.querySelectorAll('.toggle-label');
		const priceCards = document.querySelectorAll('.plan-price');
		const billingNotes = document.querySelectorAll('.billing-note');

		function updatePrices(isAnnual) {
			toggle.classList.toggle('active', isAnnual);
			labels[0].classList.toggle('active', !isAnnual);
			labels[1].classList.toggle('active', isAnnual);

			priceCards.forEach(card => {
				const monthly = card.getAttribute('data-monthly');
				const annual = card.getAttribute('data-annual');
				const amountEl = card.querySelector('.amount');

				if (monthly && annual && amountEl) {
					amountEl.textContent = isAnnual ? annual : monthly;
				}
			});

			billingNotes.forEach(note => {
				note.textContent = isAnnual
					? note.getAttribute('data-annual-note')
					: note.getAttribute('data-monthly-note');
			});
		}

		// Check URL for initial state
		const urlParams = new URLSearchParams(window.location.search);
		const initialAnnual = urlParams.has('annual');
		if (initialAnnual) {
			updatePrices(true);
		}

		toggle.addEventListener('click', () => {
			const isNowAnnual = !toggle.classList.contains('active');
			updatePrices(isNowAnnual);
			
			// Update URL without reload
			const url = new URL(window.location);
			if (isNowAnnual) {
				url.searchParams.set('annual', '');
			} else {
				url.searchParams.delete('annual');
			}
			window.history.replaceState({}, '', url);
		});
	}

	// Initialize on page load
	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initPricingToggle);
	} else {
		initPricingToggle();
	}
</script>
