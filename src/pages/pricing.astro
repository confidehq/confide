---
import Layout from '../layouts/Layout.astro';
import '../styles/pages/pricing.css';
---

<Layout title="Pricing | Confide">
	<main>
		<section class="pricing-hero">
				<span class="muted-label">PRICING</span>
				<h1>Simple, transparent pricing for <em>secure</em> data collection.</h1>
				<p>Choose the plan that fits your organization's needs. All plans include our core end-to-end encryption technology.</p>
			</section>


			<section class="pricing-toggle-wrapper">
				<div class="pricing-toggle">
					<span class={`toggle-label ${!Astro.url.searchParams.has('annual') ? 'active' : ''}`}>Monthly</span>
					<button class="toggle-btn" id="pricing-toggle" aria-label="Toggle pricing period">
						<div class="toggle-slider"></div>
					</button>
					<span class={`toggle-label ${Astro.url.searchParams.has('annual') ? 'active' : ''}`}>Annual <span class="discount-badge">Save 20%</span></span>
				</div>
			</section>

			<div class="all-plans-include">
				<span class="all-plans-label">All plans include</span>
				<div class="all-plans-items">
					<div class="all-plans-item">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
						Zero-Knowledge Architecture
					</div>
					<span class="all-plans-dot">·</span>
					<div class="all-plans-item">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
						Multi-Language
					</div>
					<span class="all-plans-dot">·</span>
					<div class="all-plans-item">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"></path><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"></path><line x1="1" y1="1" x2="23" y2="23"></line></svg>
						Anonymous Submissions
					</div>
				</div>
			</div>


			<section class="pricing-grid">
				<div class="pricing-card">
					<div class="plan-header">
						<span class="plan-name">Free</span>
						<div class="plan-price">
							<span class="currency">$</span>
							<span class="amount">0</span>
							<span class="period">/mo</span>
						</div>
						<p class="plan-desc">Everything you need to get started with secure data collection.</p>
					</div>
					<ul class="plan-features">
						<li>
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
							Unlimited Forms
						</li>
						<li>
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
							300 Responses /mo
						</li>
						<li>
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
							2,000 Stored responses
						</li>
						<li>
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
							1 Workspace
						</li>
						<li>
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
							2 Team members
						</li>
						<li>
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
							50 Email notifications /mo
						</li>
					</ul>
					<a href="https://admin.useconfide.app/signup" class="btn btn-secondary plan-btn">Get started free</a>
				</div>

				<div class="pricing-card featured">
