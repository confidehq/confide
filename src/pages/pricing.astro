<script is:inline>
	function initPricingToggle() {
		const toggle = document.getElementById('pricing-toggle');
		if (!toggle) return;

		const labels = document.querySelectorAll('.toggle-label');
		const priceCards = document.querySelectorAll('.plan-price');
		
		function updatePrices(isAnnual) {
			toggle.classList.toggle('active', isAnnual);
			labels[0].classList.toggle('active', !isAnnual);
			labels[1].classList.toggle('active', isAnnual);
			
			priceCards.forEach(card => {
				const monthly = card.getAttribute('data-monthly');
				const annual = card.getAttribute('data-annual');
				const amountEl = card.querySelector('.amount');
				const periodEl = card.querySelector('.period');
				
				if (monthly && annual && amountEl) {
					amountEl.textContent = isAnnual ? annual : monthly;
					// Optionally update period text or keep as /mo but with different amount
				}
			});
		}

		// Check URL for initial state
		const urlParams = new URLSearchParams(window.location.search);
		const initialAnnual = urlParams.has('annual');
		if (initialAnnual) {
			updatePrices(true);
		}

		toggle.addEventListener('click', () => {
			const isNowAnnual = !toggle.classList.contains('active');
			updatePrices(isNowAnnual);
			
			// Update URL without reload
			const url = new URL(window.location);
			if (isNowAnnual) {
				url.searchParams.set('annual', '');
			} else {
				url.searchParams.delete('annual');
			}
			window.history.replaceState({}, '', url);
		});
	}

	// Initialize on page load
	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initPricingToggle);
	} else {
		initPricingToggle();
	}
</script>
