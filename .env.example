# Required
WISP_DATABASE_URL=postgresql://wisp:changeme@localhost:5432/wisp?sslmode=disable
# Generate with: openssl rand -base64 32 | tr '+/' '-_'
WISP_HMAC_KEY=

# Optional (defaults shown)
WISP_BIND_ADDR=:8080
WISP_RELAY_FLUSH_INTERVAL=60s
WISP_CORS_ORIGIN=http://localhost:3000
WISP_RP_ID=localhost
WISP_RP_ORIGIN=http://localhost:3000
WISP_RP_DISPLAY_NAME=Wisp
WISP_ENV=development
WISP_REGISTRATION_OPEN=true

# Self-hosting (used by deploy/docker-compose.yml)
WISP_DOMAIN=wisp.example.com
DB_PASSWORD=changeme
