# Required
GHOSTFORM_DATABASE_URL=postgresql://ghostform:changeme@localhost:5432/ghostform?sslmode=disable
# Generate with: openssl rand -base64 32 | tr '+/' '-_'
GHOSTFORM_HMAC_KEY=

# Optional (defaults shown)
GHOSTFORM_BIND_ADDR=:8080
GHOSTFORM_CORS_ORIGIN=http://localhost:3000
GHOSTFORM_RP_ID=localhost
GHOSTFORM_RP_ORIGIN=http://localhost:3000
GHOSTFORM_RP_DISPLAY_NAME=GhostForm
GHOSTFORM_ENV=development

# Docker Compose
DB_PASSWORD=changeme
HMAC_KEY=
