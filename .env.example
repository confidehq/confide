# Confide Environment Configuration
# Copy this file to .env and modify as needed for your deployment.
#   cp .env.example .env


# ── Required ──────────────────────────────────────────────────────────────────

# Generate with: openssl rand -base64 32 | tr '+/' '-_'
CONFIDE_HMAC_KEY=

# PostgreSQL connection string
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
# For Docker: use 'postgres' as the hostname
# For local development: use 'localhost:5432'
CONFIDE_DATABASE_URL=postgresql://confide:confide@localhost:5432/confide?sslmode=disable

# ── WebAuthn ──────────────────────────────────────────────────────────────────
# CONFIDE_RP_ID must be the effective domain (e.g. example.com).
# Subdomains (app.example.com) can authenticate with the parent domain as RP ID.
# Changing this after users have registered will break all existing passkeys.

CONFIDE_RP_ID=localhost
CONFIDE_RP_ORIGIN=http://localhost:8080
CONFIDE_RP_DISPLAY_NAME=Confide

# ── CORS ──────────────────────────────────────────────────────────────────────
# Must match the origin your browser uses to reach the app.
# When the frontend is served by the API (default), this equals CONFIDE_RP_ORIGIN.

CONFIDE_CORS_ORIGIN=http://localhost:8080

# ── SMTP ──────────────────────────────────────────────────────────────────────
# All SMTP fields are optional. If CONFIDE_SMTP_HOST is not set, invitation
# emails are silently skipped and invitations still work (link is returned in
# the API response).
#
# CONFIDE_SMTP_PORT defaults to 587 (STARTTLS) when not set.
# CONFIDE_FROM_EMAIL is the envelope/From address shown to recipients.

# CONFIDE_SMTP_HOST=smtp.example.com
# CONFIDE_SMTP_PORT=587
# CONFIDE_SMTP_USER=user@example.com
# CONFIDE_SMTP_PASS=
# CONFIDE_FROM_EMAIL=noreply@example.com

CONFIDE_STRIPE_SECRET_KEY=
CONFIDE_STRIPE_WEBHOOK_SECRET=
CONFIDE_STRIPE_PRICE_PRO=
CONFIDE_STRIPE_PRICE_ORG=
# ── Optional ──────────────────────────────────────────────────────────────────

CONFIDE_BIND_ADDR=:8080
CONFIDE_ENV=development

# ── Subdomain routing ─────────────────────────────────────────────────────────
# CONFIDE_APP_DOMAIN  — admin dashboard origin (with scheme), e.g. https://app.example.com
# CONFIDE_FORMS_DOMAIN — bare hostname for public form hosting, e.g. forms.example.com
#
# When CONFIDE_FORMS_DOMAIN is set, share URLs point to that domain and requests
# arriving on it are restricted to public form-serving routes only. Requests for
# admin routes (dashboard, auth, settings) are redirected to CONFIDE_APP_DOMAIN.
#
# CONFIDE_APP_DOMAIN=https://app.example.com
# CONFIDE_FORMS_DOMAIN=forms.example.com

# Allow any user to register an account (default: true).
# CONFIDE_REGISTRATION_OPEN=false

# How often the relay flushes buffered messages to connected clients (default: 60s).
# CONFIDE_RELAY_FLUSH_INTERVAL=60s

# How often expired invitations and sessions are reaped from the database (default: 1h).
# CONFIDE_REAPER_INTERVAL=1h

# For local development
CONFIDE_DOMAIN=localhost
