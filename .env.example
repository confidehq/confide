# Confide Environment Configuration
# Copy this file to .env and modify as needed for your deployment.
#   cp example.env .env


# ── Required ──────────────────────────────────────────────────────────────────

# Generate with: openssl rand -base64 32 | tr '+/' '-_'
CONFIDE_HMAC_KEY=

# PostgreSQL connection string
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
# For Docker: use 'postgres' as the hostname
# For local development: use 'localhost:5432'
CONFIDE_DATABASE_URL=postgresql://confide:changeme@localhost:5432/confide?sslmode=disable

# ── WebAuthn ──────────────────────────────────────────────────────────────────
# CONFIDE_RP_ID must be the effective domain (e.g. example.com).
# Subdomains (app.example.com) can authenticate with the parent domain as RP ID.
# Changing this after users have registered will break all existing passkeys.

CONFIDE_RP_ID=localhost
CONFIDE_RP_ORIGIN=http://localhost:8080
CONFIDE_RP_DISPLAY_NAME=Confide

# ── CORS ──────────────────────────────────────────────────────────────────────
# Must match the origin your browser uses to reach the app.
# When the frontend is served by the API (default), this equals CONFIDE_RP_ORIGIN.

CONFIDE_CORS_ORIGIN=http://localhost:8080

# ── Optional ──────────────────────────────────────────────────────────────────

CONFIDE_BIND_ADDR=:8080
CONFIDE_ENV=development
CONFIDE_REGISTRATION_OPEN=true
# CONFIDE_RELAY_FLUSH_INTERVAL=60s

# For local development 
CONFIDE_DOMAIN=localhost
