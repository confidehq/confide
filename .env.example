# ═══════════════════════════════════════════════════════════════════════════
# CONFIDE - ENVIRONMENT CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════
# 
# Quick Start:
#   1. Copy this file:        cp .env.example .env
#   2. Fill in REQUIRED fields 
#   3. Customize OPTIONAL fields as needed
#   4. Keep ADVANCED defaults unless you know what you're doing
#
# ═══════════════════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────────────────
# REQUIRED - Must be configured before first run
# ───────────────────────────────────────────────────────────────────────────

# Application secret key (32+ random characters)
# Generate with: openssl rand -base64 32 | tr '+/' '-_'
# Keep this secret! Used for session encryption and security tokens
CONFIDE_SECRET_KEY=

# Database connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# 
# Docker example:    postgresql://confide:confide@postgres:5432/confide
# Local example:     postgresql://confide:confide@localhost:5432/confide?sslmode=disable
CONFIDE_DATABASE_URL=postgresql://confide:confide@localhost:5432/confide?sslmode=disable


# ───────────────────────────────────────────────────────────────────────────
# 🌐 DOMAIN & NETWORKING - Configure your URLs
# ───────────────────────────────────────────────────────────────────────────

# Port the server listens on (default: 8080)
# CONFIDE_PORT=8080

# Port the frontend listens on (default: 3000)
# CONFIDE_WEB_PORT=3000

# Environment mode: development | production (default: development)
# CONFIDE_ENV=development

# Main application domain (with scheme)
# Examples:
#   Local development:  http://localhost:8080
#   Production:         https://app.example.com
# CONFIDE_APP_DOMAIN=http://localhost:8080

# Optional: Separate subdomain for public form hosting
# When set, public forms are served from this domain 
# Example: https://forms.example.com
# CONFIDE_FORMS_DOMAIN=


# ───────────────────────────────────────────────────────────────────────────
# 🔐 WEBAUTHN (Passkeys) - For passwordless authentication
# ───────────────────────────────────────────────────────────────────────────

# Relying Party ID - Must be the effective domain (e.g., example.com)
# 
# IMPORTANT: Changing this after users register will BREAK all passkeys!
# 
# Rules:
#   - Use parent domain for subdomains (app.example.com → example.com)
#   - Use 'localhost' for local development
#   - No scheme (http/https), no port, no path
CONFIDE_RP_ID=localhost

# Relying Party Origin (optional)
# Defaults to CONFIDE_APP_DOMAIN if not set
# Only set this if WebAuthn origin differs from APP_DOMAIN
# CONFIDE_RP_ORIGIN=http://localhost:8080

# Display name shown in passkey prompts (default: Confide)
# CONFIDE_RP_DISPLAY_NAME=Confide


# ───────────────────────────────────────────────────────────────────────────
# 📧 EMAIL (SMTP) - For sending invitation emails
# ───────────────────────────────────────────────────────────────────────────

# All SMTP fields are OPTIONAL
# If not configured, invitations still work (link returned in API response)
# but no emails are sent

# SMTP server hostname
# CONFIDE_SMTP_HOST=smtp.gmail.com

# SMTP port (default: 587 for STARTTLS)
# Common ports:
#   587 - STARTTLS (recommended)
#   465 - SSL/TLS
# CONFIDE_SMTP_PORT=587

# SMTP authentication credentials
# CONFIDE_SMTP_USER=your-email@gmail.com
# CONFIDE_SMTP_PASS=your-app-password

# From address shown to email recipients
# CONFIDE_FROM_EMAIL=noreply@example.com


# ───────────────────────────────────────────────────────────────────────────
# 💳 STRIPE - For payment processing (optional)
# ───────────────────────────────────────────────────────────────────────────

# Leave blank to disable billing features

# Stripe secret key (starts with sk_test_ or sk_live_)
# Get from: https://dashboard.stripe.com/apikeys
CONFIDE_STRIPE_SECRET_KEY=

# Webhook signing secret (starts with whsec_)
# Get from: https://dashboard.stripe.com/webhooks
CONFIDE_STRIPE_WEBHOOK_SECRET=

# Price IDs for subscription plans
# Get from: https://dashboard.stripe.com/products
CONFIDE_STRIPE_PRICE_PRO=
CONFIDE_STRIPE_PRICE_ORG=


# ───────────────────────────────────────────────────────────────────────────
# 🔧 ADVANCED - Fine-tuning (usually not needed)
# ───────────────────────────────────────────────────────────────────────────

# Allow public user registration (default: true)
# Set to false to require admin invitations
# CONFIDE_REGISTRATION_OPEN=true

# CORS allowed origins (optional)
# Defaults to CONFIDE_APP_DOMAIN (and CONFIDE_FORMS_DOMAIN if set)
# Only set this if you need additional origins
# Format: comma-separated list
# CONFIDE_CORS_ORIGIN=http://localhost:3000,https://app.example.com

# Message relay flush interval (default: 60s)
# How often buffered messages are sent to connected clients
# CONFIDE_RELAY_FLUSH_INTERVAL=60s

# Database cleanup interval (default: 1h)
# How often expired invitations and sessions are removed
# CONFIDE_REAPER_INTERVAL=1h


# ═══════════════════════════════════════════════════════════════════════════
# 📝 CONFIGURATION EXAMPLES
# ═══════════════════════════════════════════════════════════════════════════

# ── Example 1: Local Development ──
# CONFIDE_SECRET_KEY=dGVzdC1zZWNyZXQta2V5LWZvci1kZXZlbG9wbWVudC1vbmx5
# CONFIDE_DATABASE_URL=postgresql://confide:confide@localhost:5432/confide?sslmode=disable
# CONFIDE_PORT=8080
# CONFIDE_ENV=development
# CONFIDE_RP_ID=localhost
# CONFIDE_REGISTRATION_OPEN=true

# ── Example 2: Production (Single Domain) ──
# CONFIDE_SECRET_KEY=<your-generated-secret>
# CONFIDE_DATABASE_URL=postgresql://confide:password@db.internal:5432/confide
# CONFIDE_PORT=8080
# CONFIDE_ENV=production
# CONFIDE_APP_DOMAIN=https://confide.example.com
# CONFIDE_RP_ID=example.com
# CONFIDE_SMTP_HOST=smtp.sendgrid.net
# CONFIDE_SMTP_PORT=587
# CONFIDE_SMTP_USER=apikey
# CONFIDE_SMTP_PASS=<your-sendgrid-api-key>
# CONFIDE_FROM_EMAIL=noreply@example.com
# CONFIDE_REGISTRATION_OPEN=false

# ── Example 3: Production (Subdomain Split) ──
# CONFIDE_SECRET_KEY=<your-generated-secret>
# CONFIDE_DATABASE_URL=postgresql://confide:password@db.internal:5432/confide
# CONFIDE_PORT=8080
# CONFIDE_ENV=production
# CONFIDE_APP_DOMAIN=https://app.example.com
# CONFIDE_FORMS_DOMAIN=https://forms.example.com
# CONFIDE_RP_ID=example.com
# CONFIDE_SMTP_HOST=smtp.gmail.com
# CONFIDE_SMTP_PORT=587
# CONFIDE_SMTP_USER=admin@example.com
# CONFIDE_SMTP_PASS=<app-password>
# CONFIDE_FROM_EMAIL=noreply@example.com
# CONFIDE_STRIPE_SECRET_KEY=sk_live_xxxxx
# CONFIDE_STRIPE_WEBHOOK_SECRET=whsec_xxxxx
# CONFIDE_STRIPE_PRICE_PRO=price_xxxxx
# CONFIDE_STRIPE_PRICE_ORG=price_xxxxx
